#
# system.prop for ancora
#

# RIL: AOSP rild (HIDL) + libsecril_shim wrapping vendor libsec-ril.so
rild.libpath=/system/lib/libsecril_shim.so
rild.libargs=-d /dev/smd0

ro.ril.hsxpa=1
ro.ril.gprsclass=10

# Ril sends only one RIL_UNSOL_CALL_RING, so set call_ring.multiple to false
ro.telephony.call_ring.multiple=0

# Wifi interface device
wifi.interface=wlan0

# Oreo EGL driver loader (frameworks/native/opengl/libs/EGL/Loader.cpp):
# selects /system [/vendor]/lib/egl/libEGL_adreno.so deterministically;
# egl.cfg is no longer read in Oreo.
ro.hardware.egl=adreno

# hw_get_module variant for the Samsung sensors blob (installed as both
# sensors.ancora.so, matching the shim preload path, and sensors.default.so,
# matching hw_get_module's final fallback). Oreo's sensors HIDL service loads
# the legacy module through hw_get_module, which walks
# ro.hardware/ro.product.board/ro.board.platform/ro.arch and ends with the
# .default.so name.
ro.hardware.sensors=ancora

# Density in DPI of the LCD of this board. This is used to scale the UI
# appropriately. If this property is not defined, the default value is 160 dpi.
ro.sf.lcd_density=240

# The OpenGL ES API level that is natively supported by this device.
# This is a 16.16 fixed point number.
ro.opengles.version=131072

# QCOM
debug.sf.hw=1
debug.composition.type=dyn

# Disable gapless mode
audio.gapless.playback.disable=true

# Disable offload audio
audio.offload.disable=1

# Low memory device
ro.config.low_ram=true

# Reduce background apps limit to 16 on low-tier devices
ro.sys.fw.bg_apps_limit=16

# Set max background services
ro.config.max_starting_bg=8

# ART
dalvik.vm.dex2oat-swap=false

# Custom dalvik heap parameters for 512MB
dalvik.vm.heapstartsize=5m
dalvik.vm.heapgrowthlimit=48m
dalvik.vm.heapsize=144m
dalvik.vm.heaptargetutilization=0.9
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=2m
