# system apps (AriesParts etc.)

# Legacy Adreno 205 EGL opens /dev/kgsl directly
allow system_app gpu_device:chr_file rw_file_perms;

# Device tunables exposed in sysfs (calibration, fast charge, amp)
allow system_app sysfs_custom:dir search;
allow system_app sysfs_custom:file rw_file_perms;
allow system_app sysfs_custom:lnk_file read;
