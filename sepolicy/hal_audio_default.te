# audio-hal-2-0 running the legacy ALSA HAL + libaudioalsa

# msm audio mixer/pcm devices
allow hal_audio_default audio_device:dir r_dir_perms;
allow hal_audio_default audio_device:chr_file rw_file_perms;

# YDA165 amplifier tunables
allow hal_audio_default sysfs_custom:dir search;
allow hal_audio_default sysfs_custom:file rw_file_perms;
