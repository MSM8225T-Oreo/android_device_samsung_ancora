# Property contexts for ancora (merged with AOSP contexts, longest prefix wins)

# Samsung remote storage daemon control (rmt_storage <-> init)
ctl.rmt                u:object_r:ctl_rmt_prop:s0

# Samsung RIL exposes runtime state (ril.bt_macaddr, ril.wifi_macaddr)
# and the shim proxies gsm.* unsolicited state.
ril.                   u:object_r:radio_prop:s0
gsm.                   u:object_r:radio_prop:s0

# rild.libpath/rild.libargs are read at rild startup; unlabeled keys fall
# back to default_prop which every domain may read.
