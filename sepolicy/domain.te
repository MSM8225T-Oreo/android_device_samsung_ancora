# Broad domain rules (Oreo / Lineage 15.1)

# Legacy Adreno 205 EGL blobs open /dev/kgsl* directly from any process
# that runs GPU work (apps, surfaceflinger, camera AE, video encoders).
allow domain gpu_device:chr_file rw_file_perms;

dontaudit { surfaceflinger appdomain } shell_data_file:dir search;
