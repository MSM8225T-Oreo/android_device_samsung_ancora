# wpa_supplicant (nl80211 + BCM4329). Not an AOSP domain in 8.0; the legacy
# standalone daemon started from init.qcom.rc keeps its own device domain.
type wpa, domain;
type wpa_exec, exec_type, file_type;

# Started by init (see the wpa_supplicant service in init.qcom.rc)
init_daemon_domain(wpa)

# netlink to the bcmdhd driver
allow wpa self:capability { net_admin net_raw };
allow wpa self:netlink_socket create_socket_perms;
allow wpa self:netlink_route_socket { bind create nlmsg_read nlmsg_write };

# daemon runs as the wifi user but needs to manage rfkill for LPM
allow wpa rfkill_device:chr_file { open read };

# control socket plumbing + /data/misc/wifi state
allow wpa wifi_data_file:dir create_dir_perms;
allow wpa wifi_data_file:file create_file_perms;
type_transition wpa wifi_data_file:dir wpa_socket "sockets";
