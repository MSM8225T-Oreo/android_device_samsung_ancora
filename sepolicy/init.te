# init (still runs the Samsung/legacy sections of init.qcom.rc; Oreo / 15.1 policy)

# init adjusts partition attributes (chmod on /dev/block/mmcblk0p1X)
allow init mmc_block_device:blk_file { open setattr };

# init copies /data/dump_enable into /proc/dump_enable (silent reset toggle)
allow init proc:file write;

# device sysfs nodes chown'd/chmod'd by init.qcom.rc
allow init sysfs:dir_file_class_set setattr;
